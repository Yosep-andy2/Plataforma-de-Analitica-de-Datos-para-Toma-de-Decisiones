# ============================================
# BACKEND - ENVIRONMENT VARIABLES EXAMPLE
# ============================================
# Copy this file to .env and fill with your values

# ===== DATABASE =====
DATABASE_URL=postgresql://analytics_user:analytics_pass@localhost:5432/analytics_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===== REDIS =====
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ===== SECURITY =====
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== ENVIRONMENT =====
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ===== EMAIL (Optional) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@analytics-platform.com

# ===== EXTERNAL APIS (Optional) =====
ERP_API_URL=https://erp.company.com/api
ERP_API_KEY=your-erp-api-key
CRM_API_URL=https://crm.company.com/api
CRM_API_KEY=your-crm-api-key

# ===== FILE STORAGE =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# ===== MONITORING =====
ENABLE_METRICS=True
SENTRY_DSN=
