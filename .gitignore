# ============================================
# PLATAFORMA DE ANALÍTICA DE DATOS
# .gitignore - Configuración Global
# ============================================

# ===== PYTHON =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# ===== NODE.JS / FRONTEND =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
.npm
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity

# Build outputs
dist/
build/
.next/
out/
.nuxt/
.cache/
.parcel-cache/

# ===== BASES DE DATOS =====
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.log

# PostgreSQL
*.pgsql

# MySQL
*.mysql

# ===== ARCHIVOS DE CONFIGURACIÓN SENSIBLES =====
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
config/secrets.yml
config/database.yml
credentials.json
token.json
*.pem
*.key
*.cert
*.crt
secrets/

# ===== DOCKER =====
docker-compose.override.yml
.dockerignore

# ===== IDEs y EDITORES =====
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ===== SISTEMA OPERATIVO =====
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ===== TESTING =====
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
nosetests.xml
test-results/
junit.xml

# ===== DATA & ML =====
# Datasets grandes
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.json
data/processed/*.csv
data/processed/*.parquet

# Modelos entrenados
models/*.pkl
models/*.h5
models/*.joblib
models/*.pt
models/*.pth
*.ckpt

# MLflow
mlruns/
mlartifacts/

# ===== LOGS =====
logs/
*.log
log/

# ===== TEMPORAL =====
tmp/
temp/
*.tmp
*.bak
*.swp

# ===== DOCUMENTACIÓN =====
# Evitar archivos generados
docs/_build/
docs/.doctrees/
site/

# ===== CI/CD =====
.github/workflows/*.log

# ===== OTROS =====
.sass-cache/
*.pid
*.seed
*.pid.lock
.grunt
bower_components
